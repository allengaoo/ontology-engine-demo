{
  "name": "oncall",
  "version": 3,
  "layers": {
    "backend": [
      "models",
      "schemas",
      "domain",
      "repositories",
      "services",
      "api"
    ],
    "dependency_rule": "api -> services -> (domain|repositories) -> models"
  },
  "models": {
    "Engineer": {
      "path": "backend/src/oncall/models/engineer.py",
      "required_fields": {
        "id": ["Optional[int]", "int", "Optional"],
        "name": ["str"],
        "is_active": ["bool"]
      },
      "forbidden_fields": ["team", "active", "slot"]
    },
    "Shift": {
      "path": "backend/src/oncall/models/shift.py",
      "required_fields": {
        "id": ["Optional[int]", "int", "Optional"],
        "engineer_id": ["int"],
        "date": ["str"],
        "shift_type": ["str"]
      },
      "forbidden_fields": ["shift_date", "engineer_name", "slot"],
      "shift_type_enum": ["primary", "backup"]
    },
    "Roster": {
      "path": "backend/src/oncall/models/roster.py",
      "required_fields": {
        "shifts": ["List", "list"]
      },
      "forbidden_fields": ["engineers", "entries", "roster_entries"]
    }
  },
  "schemas": {
    "CreateEngineerRequest": {
      "path": "backend/src/oncall/schemas/engineer.py",
      "required_fields": ["name"],
      "optional_fields": ["is_active"],
      "forbidden_fields": ["id", "team", "active"]
    }
  },
  "api": {
    "CreateEngineerRequest": {
      "required_fields": ["name"],
      "optional_fields": ["is_active"],
      "forbidden_fields": ["id", "team"]
    },
    "routes": {
      "prefix": "/api/v1",
      "engineers": "/api/v1/engineers",
      "roster_generate": "/api/v1/roster/generate"
    },
    "errors": {
      "roster_conflict": {
        "status": 409,
        "detail_code": "ROSTER_CONFLICT"
      }
    }
  },
  "domain_contracts": {
    "validate_roster": "pure_function_no_db",
    "generate_week_returns": "Roster",
    "generate_week_requires_primary_per_day": true,
    "empty_active_raises": "RuleViolation"
  },
  "frontend": {
    "pages_allowlist": [
      "frontend/src/pages/EngineersPage.tsx",
      "frontend/src/pages/RosterWeekPage.tsx",
      "frontend/src/pages/RulesPage.tsx"
    ],
    "components_allowlist": [
      "frontend/src/components/ErrorBanner.tsx",
      "frontend/src/components/EngineerForm.tsx",
      "frontend/src/components/WeekGrid.tsx"
    ],
    "forbidden_aliases": ["@/"]
  },
  "freeze_defaults": {
    "after_models": ["backend/src/oncall/models/"]
  }
}
