# ============================================================
# ifclubdemo 环境变量模板
# 复制为 .env 并填入真实值：
#   cp .env.example .env
# ============================================================

# ── LLM（小模型 <50B，云端模拟端侧）──────────────────────────

# API 密钥（必填）
LLM_API_KEY=

# API 地址（DashScope 兼容 OpenAI）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型 DashScope id（展示名 Qwen3-Coder-30B-A3B-Instruct）
LLM_MODEL=qwen3-coder-30b-a3b-instruct

# 设为 0 可关闭端侧模型强制（不推荐）
# DEMOCODE_EDGE_MODEL=1

# 全量 LLM 模式：禁止 stub fallback（默认 0=禁用 stub）
DEMOCODE_ALLOW_STUB=0

# ── 工作区 ───────────────────────────────────────────────────

# 所有应用 / EP 产物默认根目录（相对 ifclubdemo/ 或绝对路径）
# 默认：democode/ifclubdemo/workspace
IFCLUB_WORKSPACE=./workspace

# 默认应用子目录名（init-app meeting_order → $IFCLUB_WORKSPACE/meeting_order）
IFCLUB_APP=meeting_order
