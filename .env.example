# ============================================================
# ontology-engine-demo 环境变量配置模板
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env
# ============================================================

# ── LLM 配置（Phase 6/7/8 端侧小模型 demo）────────────────────

# API 密钥（必填，DashScope 兼容 OpenAI 接口）
LLM_API_KEY=

# API 接口地址（推荐 DashScope）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称：端侧 demo 固定使用 qwen3-32b（029 系列验证模型）
# 若误填 qwen3.7-max 等更大模型，llm_chat 会强制回退到 qwen3-32b
LLM_MODEL=qwen3-32b

# 设为 0 可关闭端侧模型强制（不推荐，仅调试大模型时用）
# DEMOCODE_EDGE_MODEL=1
